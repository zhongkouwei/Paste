{
  "name": "paste-easy",
  "version": "0.2.0",
  "description": "A macOS clipboard history app inspired by Paste.",
  "productName": "Paste Easy",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:ui": "playwright test",
    "test:packaged": "PASTE_TEST_PACKAGED=1 playwright test",
    "build:native": "node scripts/build-native.js",
    "build": "npm run check && npm run test && npm run build:native && node scripts/build-app.js",
    "build:zip": "npm run build && ditto -c -k --sequesterRsrc --keepParent \"release/mac-arm64/Paste Easy.app\" \"release/Paste-Easy-dev-arm64.zip\"",
    "build:release": "npm run check && npm run test && npm run test:ui && npm run build:native && node scripts/build-app.js --release && npm run release:verify",
    "release:verify": "node scripts/verify-release.js"
  },
  "keywords": [
    "clipboard",
    "macos",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.zhongkouwei.pastelike",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "native/bin/**/*",
      "package.json",
      "package-lock.json",
      "!node_modules/.cache/**/*"
    ],
    "asar": true,
    "asarUnpack": ["native/bin/**/*"],
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": { "LSUIElement": true },
      "target": [
        "dir"
      ]
    }
  }
}
